__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Audio files — too large for version control
*.wav
*.mp3
*.flac
*.aiff
*.ogg

# MIDI files — generated outputs, not source
*.mid
*.midi

# Soundfonts — large binary files, distribute separately
*.sf2
*.sf3
*.sfz

# Scratch/temp files generated by the scripts
*.temp.wav

# Song config — contains local SF2 paths, use song_config.example.yaml as reference
song_config.yaml

# macOS
.DS_Store

# IDEs
.vscode/
.idea/
*.swp
*.swo
# Local Codex metadata
.claude/

# Local pre-release review tracking (not for publication)
REVIEW_TICKETS.md
